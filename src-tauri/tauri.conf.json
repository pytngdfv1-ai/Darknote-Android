{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DarkNote",
  "version": "1.0.0",
  "identifier": "com.darknote.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DarkNote",
        "width": 1000,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["txt","html","css","js","json","md","py","java","cpp","c","ts","xml","yml","yaml"],
        "name": "Documento DarkNote",
        "description": "Documento de texto abierto con DarkNote",
        "role": "Editor"
      }
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}